# ======================================================
# DJANGO CORE
# ======================================================

# Chave secreta do Django
# Gere uma nova em produção
DJANGO_SECRET_KEY=

# Debug (True ou False)
DJANGO_DEBUG=False

# Hosts permitidos (separados por vírgula)
# Ex:
# 127.0.0.1,localhost
# meusite.com,www.meusite.com
DJANGO_ALLOWED_HOSTS=

# ======================================================
# DJANGO SECURITY
# ======================================================

# Origens confiáveis para CSRF
# Ex:
# https://meusite.com,https://www.meusite.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# ======================================================
# DATABASE
# ======================================================

# PostgreSQL
# Ex:
# postgresql://usuario:senha@localhost:5432/blogdb
DATABASE_URL=

# ======================================================
# REDIS / CACHE
# ======================================================

# Redis URL
# Ex:
# redis://127.0.0.1:6379/1
REDIS_URL=

# ======================================================
# CLOUDINARY
# ======================================================

# URL completa Cloudinary
# Ex:
# cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=

# Variáveis opcionais explícitas
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ======================================================
# EMAIL (FUTURO)
# ======================================================

EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# ======================================================
# SITE
# ======================================================

SITE_URL=https://entrebugsesolucoes.com.br